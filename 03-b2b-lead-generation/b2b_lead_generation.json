{
  "name": "B2B Lead Generation & Qualification",
  "nodes": [
    {
      "id": "1",
      "name": "Manual Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -1400,
        300
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Define Search Criteria",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1180,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "regions",
              "type": "array",
              "value": "={{ [\"الجزائر العاصمة\", \"وهران\", \"قسنطينة\", \"عنابة\"] }}"
            },
            {
              "id": "c2",
              "name": "specialty",
              "type": "string",
              "value": "عيادات تجميل"
            },
            {
              "id": "c3",
              "name": "min_rating",
              "type": "number",
              "value": 4
            },
            {
              "id": "c4",
              "name": "must_have_website",
              "type": "boolean",
              "value": false
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Split Out Regions",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -960,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "regions"
      }
    },
    {
      "id": "4",
      "name": "Loop Over Regions",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -740,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "5",
      "name": "Search Leads (Google Places)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://maps.googleapis.com/maps/api/place/textsearch/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{$json.specialty + ' في ' + $json.regions}}"
            },
            {
              "name": "key",
              "value": "YOUR_GOOGLE_PLACES_API_KEY"
            }
          ]
        }
      }
    },
    {
      "id": "6",
      "name": "Split Out Places",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -300,
        400
      ],
      "parameters": {
        "fieldToSplitOut": "results"
      }
    },
    {
      "id": "7",
      "name": "Loop Over Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -80,
        400
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "8",
      "name": "Get Place Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "https://maps.googleapis.com/maps/api/place/details/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "place_id",
              "value": "={{$json.place_id}}"
            },
            {
              "name": "fields",
              "value": "name,formatted_phone_number,website,rating,formatted_address"
            },
            {
              "name": "key",
              "value": "YOUR_GOOGLE_PLACES_API_KEY"
            }
          ]
        }
      }
    },
    {
      "id": "9",
      "name": "Classify Lead (AI)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        360,
        500
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.result) }}",
        "options": {
          "systemMessage": "أنت محلل مبيعات B2B. بناءً على بيانات العميل المحتمل (الاسم، التقييم، الموقع الإلكتروني، الهاتف)، صنّف العميل إلى 'مؤهل' أو 'غير مؤهل' حسب معايير: تقييم 4 نجوم فأعلى، ونشاط تجاري حقيقي وليس فرعاً تابعاً لسلسلة كبرى. أعد النتيجة بصيغة JSON فقط بالشكل: {\"qualified\": true/false, \"reason\": \"...\"}"
        }
      }
    },
    {
      "id": "10",
      "name": "Is Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        580,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{JSON.parse($json.output).qualified}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "11",
      "name": "Generate Outreach Message (AI)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        800,
        400
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($('Get Place Details').item.json.result) }}",
        "options": {
          "systemMessage": "اكتب رسالة تواصل أولى قصيرة واحترافية باللغة العربية لصاحب هذا النشاط التجاري، تعرّفه بخدماتنا وتفتح باب الحوار، دون أن تبدو كرسالة جماعية آلية."
        }
      }
    },
    {
      "id": "12",
      "name": "Log Qualified Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1020,
        400
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_LEADS_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "region": "={{$('Loop Over Regions').item.json.regions}}",
            "name": "={{$('Get Place Details').item.json.result.name}}",
            "phone": "={{$('Get Place Details').item.json.result.formatted_phone_number}}",
            "website": "={{$('Get Place Details').item.json.result.website}}",
            "rating": "={{$('Get Place Details').item.json.result.rating}}",
            "outreach_message": "={{$json.output}}",
            "status": "بانتظار التواصل"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "13",
      "name": "Loop Back (Leads)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        800,
        620
      ],
      "parameters": {}
    }
  ],
